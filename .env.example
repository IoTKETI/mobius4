# Copy to .env and edit. `docker compose` reads .env from this directory automatically.
#
#   cp .env.example .env
#   docker compose up -d
#
# .env is gitignored. Everything in it that is not a port number is a credential.

# ── Database ──────────────────────────────────────────────────────────────────────────────────
# Required: compose refuses to start without them. They are used both to create the PostgreSQL
# role and for mobius4 to connect, so they only have to agree with themselves.
DB_USER=mobius4
DB_PW=change-me
DB_NAME=mobius4

# The official PostGIS image publishes linux/amd64 only, so on an arm64 host (Apple Silicon,
# Graviton) the pull fails with "no matching manifest for linux/arm64". Uncomment one of these
# multi-architecture community builds there. Both carry the same PostgreSQL and PostGIS versions;
# neither is published by the PostGIS project itself, so pin a digest if that matters to you.
#POSTGRES_IMAGE=imresamu/postgis:17-3.5
#POSTGRES_IMAGE=ghcr.io/baosystems/postgis:17

# ── CSE identity ──────────────────────────────────────────────────────────────────────────────
# The address other CSEs and AEs should use to reach this one. config/default.json says
# http://localhost:7599, which is correct for a developer and wrong for anything else -- it is
# what this CSE advertises about itself, so it has to be reachable from outside the container.
CSE_POA=http://YOUR_SERVER_IP:7599

# Optional. Left unset, config/default.json applies: /Mobius4, //localhost, Mobius.
#CSE_ID=/Mobius4
#CSE_SP_ID=//your-domain.io
#CSE_BASE_RN=Mobius

# ── Administrator identity ────────────────────────────────────────────────────────────────────
# Names the identity the admin <accessControlPolicy> grants all six operations to. It is a
# credential: whatever sends it as X-M2M-Origin gets everything that policy allows.
#
# Leave it blank and the container generates one on first start, prints it once, and keeps it on
# a Docker volume so that later starts reuse it. Set it here and that value is used instead --
# which is the better path if you already have somewhere to keep secrets, because the volume is
# one `docker compose down -v` away from being gone.
#
# "SM" is refused: it shipped as the default up to v4.5.1 and is in this repository's history.
CSE_ADMIN=

# Length of a generated identity, including the leading S. 12 is about 2^66 combinations.
#CSE_ADMIN_LENGTH=12

# ── Ports published to the host ───────────────────────────────────────────────────────────────
#HTTP_PUBLISH_PORT=7599
#HTTPS_PUBLISH_PORT=7580

# ── TLS ───────────────────────────────────────────────────────────────────────────────────────
# Off by default. To serve HTTPS, put the key and certificate in ./certs (mounted read-only at
# /app/certs) and set these. Full procedure: docs/tls.md.
HTTPS_ENABLED=false
#HTTPS_KEY=certs/server.key
#HTTPS_CERT=certs/server.crt
#HTTPS_CHAIN=

# ── Security ──────────────────────────────────────────────────────────────────────────────────
# On by default here, off in config/default.json -- the defaults there suit a developer running
# from source. Turn them off only if something in front of mobius4 is doing the same job.
HELMET_ENABLED=true
RATELIMIT_ENABLED=true
RATELIMIT_MAX=500

# ── Logging ───────────────────────────────────────────────────────────────────────────────────
# Container logging is stdout only; the log driver rotates it. "debug" costs about 7% throughput
# and adds a line per request.
LOG_LEVEL=info

# ── MQTT ──────────────────────────────────────────────────────────────────────────────────────
#MQTT_ENABLED=true
