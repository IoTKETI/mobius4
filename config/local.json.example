{
  "_comment": "Copy this file to config/local.json and fill in your deployment values. local.json is gitignored and always takes priority over default.json.",

  "cse": {
    "_comment_cse": "CSE identity — must be unique per deployment",

    "_comment_admin": "REQUIRED, no default: mobius4 refuses to start until you set this. Names the identity that the admin <accessControlPolicy> grants all six operations to, so it reaches every resource carrying that policy — over HTTP as well as TLS. Replace the placeholder below with a value unique to this deployment and treat it as a credential.",
    "admin": "Superuser",

    "sp_id": "//your-domain.io",
    "cse_id": "/Mobius4",
    "csebase_rn": "Mobius",
    "poa": [
      "http://YOUR_SERVER_IP:7599"
    ],

    "_comment_registrar": "Only needed for MN-CSE or ASN-CSE (cse_type 2 or 3). Remove if IN-CSE (cse_type 1).",
    "registrar": {
      "ip": "PARENT_CSE_IP",
      "port": 7579
    }
  },

  "http": {
    "port": 7599
  },

  "_comment_https": "Optional, off by default. Set enabled true and point key/cert at your own PEM files to serve the HTTP binding over TLS as well; chain is for an intermediate CA bundle when your issuer provides one. Mobius4 refuses to start if enabled is true and a file cannot be read, rather than quietly serving plain HTTP. Never commit the private key. Full procedure -- obtaining a certificate, replacing it, and what TLS here does not prove about the client -- is in docs/tls.md.",
  "https": {
    "enabled": false,
    "port": 7580,
    "key": "certs/server.key",
    "cert": "certs/server.crt",
    "chain": ""
  },

  "mqtt": {
    "enabled": true,
    "ip": "localhost",
    "port": 1883
  },

  "db": {
    "user": "your_db_user",
    "pw": "your_db_password"
  },

  "_comment_logging": "DEVELOPMENT VALUES — do not carry these into a deployment. default.json already ships what a deployment wants (level \"info\", console.pretty false, file logging on); the block below overrides it for a readable terminal, and it is measurably slower. Measured 2026-08-05, concurrency 32, RETRIEVE <container>, one instance: pretty printing costs 18% (4013 -> 3288 rps), level \"debug\" a further 7% because the HTTP binding then logs one line per successful request. Together 4013 -> 2771 rps, i.e. -31%. NODE_ENV does not save you: ecosystem.config.js sets it to 'dev' unless PM2 is started with --env production, so a deployment that skips that flag keeps paying. To deploy, delete this whole logging block.",
  "logging": {
    "level": "debug",
    "console": {
      "pretty": true
    },
    "file": {
      "enabled": false
    }
  },

  "_comment_timeSeries": "Only needed if you use <timeSeries> missing-data detection. mdt_default is the missingDataDetectTimer, in seconds, used for a <timeSeries> that does not carry an mdt of its own -- TS-0001:9.6.36 makes mdt optional and gives it no default, but TS-0001:10.2.4.29 puts it in the detection time (expected dataGenerationTime + mdt), so a value is unavoidable. The shipped 60 suits periodicInterval measured in minutes; for a periodicInterval of a few seconds it means missingDataList stays empty for a full minute after a real gap. Lower it, or set mdt on the <timeSeries> itself. Note detect_missing raises whatever is here to periodicIntervalDelta + 1 when needed, so the spec's \"mdt shall be greater than periodicIntervalDelta\" holds regardless.",
  "default": {
    "timeSeries": {
      "mdt_default": 60
    }
  },

  "security": {
    "helmet": {
      "enabled": false
    },
    "rateLimit": {
      "enabled": false
    }
  }
}
